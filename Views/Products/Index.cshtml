@model IEnumerable<ProduktKatalog.Models.Product>

@{
    ViewData["Title"] = "Produkter";
}

<h2 class="mb-4">Maträtter & Bakverk</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height:200px; object-fit:cover;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p><strong>@item.Price kr</strong></p>
                    <span class="badge bg-primary mb-3">@item.Category</span>



                    <!-- + / - knappar och varukorg -->
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@item.Id" />
                        <div class="d-flex align-items-center">
                            <button type="button" class="btn btn-sm btn-outline-danger me-2" onclick="changeQuantity(this, -1)">-</button>
                            <input type="number" name="quantity" value="0" min="0" class="form-control text-center" style="width:60px;" />
                            <button type="button" class="btn btn-sm btn-outline-success ms-2" onclick="changeQuantity(this, 1)">+</button>
                        </div>
                        <button type="submit" class="btn btn-outline-primary mt-2">🛒 Lägg i varukorg</button>
                    </form>

                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Detaljer</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Redigera</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class=" btn btn-outline-primary">Ta bort</a>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function changeQuantity(btn, change) {
            let input = btn.parentElement.querySelector("input[name='quantity']");
            let value = parseInt(input.value) || 0; // börja på 0
            value = Math.max(0, value + change);   // minst 0
            input.value = value;
        }
    </script>
}
